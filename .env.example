# ==============================================
# Salin file ini menjadi .env.local lalu isi nilainya.
# JANGAN pernah commit .env.local / .env berisi credential asli.
# ==============================================

# Koneksi database PostgreSQL (Neon production / embedded postgres development).
# Development (scripts/dev-db.mjs): postgresql://postgres:password@localhost:5432/digides?schema=public
# Neon production   : postgresql://USER:PASSWORD@ep-xxxx-xxxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/digides?schema=public"

# Secret untuk next-auth (JWT session). Generate dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# WAJIB diisi di production (Vercel > Project Settings > Environment Variables).
NEXTAUTH_SECRET=""

# Opsional: wajib hanya jika hosting Anda tidak mendeteksi origin otomatis (Vercel tidak perlu).
# NEXTAUTH_URL="https://desasukamaju.id"

# Kredensial admin yang dibuat oleh `npm run db:seed` (hanya dipakai saat seed).
# Ganti SEED_ADMIN_PASSWORD sebelum seed dijalankan di environment bersama.
SEED_ADMIN_EMAIL="admin@desasukamaju.id"
SEED_ADMIN_PASSWORD="ganti-password-ini"
